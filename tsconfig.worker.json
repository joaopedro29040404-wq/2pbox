{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist-worker",
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "declaration": false,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["worker/**/*.ts", "lib/server/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist-worker"]
}
